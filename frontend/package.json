{
  "name": "pos-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings=0",
    "format": "prettier --check \"src/**/*.{ts,tsx,js,json,css,md}\"",
    "format:fix": "prettier --write \"src/**/*.{ts,tsx,js,json,css,md}\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "openapi:generate": "openapi-typescript ../backend/openapi/openapi.yaml -o src/generated/openapi.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.7.1",
    "@tanstack/react-query": "^5.59.16",
    "openapi-fetch": "^0.13.8",
    "i18next": "^23.11.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.52.1",
    "react-i18next": "^15.0.2",
    "react-router-dom": "^6.29.0",
    "zustand": "^4.5.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "openapi-typescript": "^7.10.1",
    "prettier": "^3.6.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "@vitejs/plugin-react": "^4.3.1",
    "vitest": "^3.2.4"
  }
}
