# ============ Global ============
TZ=America/Recife

# ============ Database ============
POSTGRES_USER=pos
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
POSTGRES_DB=posdb
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# ============ API ============
API_PORT=8080
JWT_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET_MIN_32_CHARS
JWT_TTL=12h
CORS_ALLOWED_ORIGINS=https://pos.localhost,http://localhost:5173
BACKUP_PATH=/var/backups/pos
BACKUP_RETENTION_COUNT=7
BACKUP_OPERATION_TIMEOUT_MS=600000
BACKUP_SIMULATION_TIMEOUT_MS=300000
BACKUP_MAX_UPLOAD_SIZE=104857600
IMPORT_PATH=/tmp/imports/pos
LEGACY_IMPORT_MAX_FILES=50
LEGACY_IMPORT_MAX_FILE_SIZE=104857600
LEGACY_IMPORT_QUEUE_NAME=legacy-import
LEGACY_IMPORT_DLQ_NAME=legacy-import-dlq
LEGACY_IMPORT_JOB_ATTEMPTS=3
LEGACY_IMPORT_JOB_BACKOFF_MS=5000
LOG_LEVEL=debug
SERVICE_NAME=pos-api
# METRICS_TOKEN=change-me-in-production
COMPANY_NAME="Magazine Medeiros"
COMPANY_ADDRESS="Rua Principal, 123 - Centro"
COMPANY_TAX_ID="00.000.000/0000-00"

# ============ FRONTEND ============
VITE_API_BASE=/api/v1
