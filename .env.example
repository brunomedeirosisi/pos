# ============ Global ============
TZ=America/Recife

# ============ Database ============
POSTGRES_USER=pos
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
POSTGRES_DB=posdb
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# ============ API ============
API_PORT=8080
JWT_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET_MIN_32_CHARS
JWT_TTL=12h
AUTH_COOKIE_NAME=pos_auth
AUTH_COOKIE_MAX_AGE_SECONDS=43200
CORS_ALLOWED_ORIGINS=https://pos.localhost,http://localhost:5173
BACKUP_PATH=/var/backups/pos
BACKUP_RETENTION_COUNT=7
BACKUP_OPERATION_TIMEOUT_MS=600000
BACKUP_SIMULATION_TIMEOUT_MS=300000
BACKUP_MAX_UPLOAD_SIZE=104857600
IMPORT_PATH=/tmp/imports/pos
LEGACY_IMPORT_MAX_FILES=50
# Optional outside Docker: path to 7zz (or 7z.exe) for ARJ decoding. API images include it.
LEGACY_ARJ_EXTRACTOR=7zz
LEGACY_IMPORT_MAX_FILE_SIZE=104857600
LEGACY_IMPORT_QUEUE_NAME=legacy-import
LEGACY_IMPORT_DLQ_NAME=legacy-import-dlq
LEGACY_IMPORT_JOB_ATTEMPTS=3
LEGACY_IMPORT_JOB_BACKOFF_MS=5000
LOG_LEVEL=debug
SERVICE_NAME=pos-api
METRICS_TOKEN=CHANGE_ME_WITH_A_RANDOM_METRICS_TOKEN_MIN_32_CHARS
# Empty means no proxy is trusted. Configure only the actual reverse proxy IP/CIDR.
TRUSTED_PROXY_CIDRS=
POSTGRES_POOL_MAX=10
POSTGRES_CONNECTION_TIMEOUT_MS=5000
POSTGRES_STATEMENT_TIMEOUT_MS=30000
POSTGRES_LOCK_TIMEOUT_MS=5000
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_ACCOUNT=10
LOGIN_RATE_LIMIT_IP=100
LOGIN_RATE_LIMIT_GLOBAL=1000
ARCHIVE_MAX_ENTRIES=5000
ARCHIVE_MAX_UNCOMPRESSED_BYTES=536870912
ARCHIVE_MAX_FILE_BYTES=536870912
ARCHIVE_MAX_DEPTH=12
ARCHIVE_TIMEOUT_MS=60000
COMPANY_NAME="Magazine Medeiros"
COMPANY_ADDRESS="Rua Principal, 123 - Centro"
COMPANY_TAX_ID="00.000.000/0000-00"
PRINT_AGENT_URL=http://host.docker.internal:9222/print
PRINT_AGENT_TIMEOUT_MS=8000
# Development uses the legacy direct agent. The store installer supplies queue credentials.
PRINT_MODE=direct
# STORE_ID=<unique-store-uuid>
# PRINT_AGENT_TOKEN_SHA256=<sha256-of-unique-Principal-agent-token>
# Terminal agents receive separate credentials through administrator-issued pairing codes.
# Their token hashes are stored in print_printer, rather than environment variables.
# PRINT_PRINTER_NAME=<exact-Windows-printer-queue-name>
# PRINT_QUEUE_LEASE_SECONDS=120
# PRINT_QUEUE_MAX_PENDING=500

# Optional first-admin bootstrap for fresh environments only.
# Set all three variables together, start the API once, then remove them.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD
# BOOTSTRAP_ADMIN_FULL_NAME=System Administrator

# ============ FRONTEND ============
VITE_API_BASE=/api/v1

# Enable restore only after validating a native backup in a disposable environment.
# Restores require maintenance, current password and explicit confirmation.
ENABLE_DATABASE_RESTORE=false
ENABLE_LEGACY_OVERWRITE=false

# Backup storage reserve; replica is optional only during development.
BACKUP_MIN_FREE_BYTES=268435456
# BACKUP_REPLICA_PATH=/existing/off-host/mount
BACKUP_REQUIRE_REPLICA=false
# BACKUP_REPLICA_HOST_PATH=/existing/off-host/mount (replica Compose overlay)
