{
  "name": "pos-api",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:init": "psql \"$POSTGRES_URL\" -f sql/init.sql",
    "migrate": "tsx src/scripts/run-migrations.ts",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "format": "prettier --check \"src/**/*.ts\" \"openapi/**/*.yaml\" \"sql/**/*.sql\"",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run src",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:regression": "vitest run --config vitest.regression.config.ts",
    "lint:rules": "node ../infra/check-lint-rules.mjs --workspace backend"
  },
  "dependencies": {
    "archiver": "^6.0.2",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.61.0",
    "cors": "^2.8.5",
    "dbffile": "^1.12.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.0.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "pg": "^8.12.0",
    "pino": "^9.9.5",
    "prom-client": "^15.1.3",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.6.0",
    "yauzl": "^3.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/archiver": "^5.3.4",
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.5.0",
    "@types/pg": "^8.11.8",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/yauzl": "^3.4.0",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "eslint": "^8.57.1",
    "prettier": "^3.6.2",
    "supertest": "^7.1.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "packageManager": "npm@12.2.0"
}
